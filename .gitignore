# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Diagnostic toolchain: the harnesses are committed, what they run on is not.
# `npm install --prefix tools/diag playwright axe-core sharp` restores them; `npx playwright install webkit chromium`
# fetches the browsers. Evidence and server logs are per-run and never committed.
tools/diag/node_modules
tools/diag/out
tools/diag/*.log

# R27 belt-and-braces. The four harnesses that used to write here now write to tools/diag/out/, which is ignored
# above; this one precise path is kept so a stray run of an older copy cannot stage 26 MB of per-run screenshots.
# Deliberately NOT broader: 58 files under docs/contact-finale/ are committed documentation, and an ignore rule
# must never be able to hide source.
docs/contact-finale/responsive/findings/

# production artifacts packaged for upload
deploy/
docs/reference/*.mp4
